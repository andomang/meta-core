@page
@model CommunityModel
@{
    ViewData["Title"] = "커뮤니티";
}

<div class="max-w-4xl mx-auto px-6 py-12 min-h-screen">
    <!-- 상단 헤더: 제목 + 글쓰기 버튼 -->
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold dark:text-white">@Model.Lang.Get("comm.title")</h2>
        <a href="/CommunityWrite" class="px-6 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-bold hover:bg-blue-700 transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            @Model.Lang.Get("comm.write")
        </a>
    </div>

    <!-- 검색 바 -->
    <form method="get" class="mb-6">
        <div class="relative">
            <input type="text" name="keyword" value="@Model.Keyword" placeholder="@Model.Lang.Get("comm.searchPh")"
                   class="w-full px-5 py-3 pr-12 border border-gray-200 dark:border-slate-700 rounded-2xl bg-white dark:bg-slate-800 dark:text-white text-sm outline-none focus:ring-2 focus:ring-blue-500" />
            <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-500">
                <i data-lucide="search" class="w-5 h-5"></i>
            </button>
        </div>
    </form>

    <!-- 게시글 목록 테이블 -->
    <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl overflow-hidden shadow-sm">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 dark:bg-slate-700/50 border-b dark:border-slate-700 text-gray-500 dark:text-slate-400">
                    <th class="py-3 px-4 text-center w-16">No</th>
                    <th class="py-3 px-4 text-left">@Model.Lang.Get("comm.colTitle")</th>
                    <th class="py-3 px-4 text-center w-28">@Model.Lang.Get("comm.colAuthor")</th>
                    <th class="py-3 px-4 text-center w-24">@Model.Lang.Get("comm.colDate")</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Posts.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="py-12 text-center text-gray-400 dark:text-slate-500">@Model.Lang.Get("comm.noPosts")</td>
                    </tr>
                }
                @foreach (var post in Model.Posts)
                {
                    <tr class="border-b dark:border-slate-700 last:border-0 hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
                        <td class="py-3 px-4 text-center text-gray-400 dark:text-slate-500">@post.No</td>
                        <td class="py-3 px-4">
                            <a href="/CommunityView?no=@post.No" class="font-semibold text-gray-800 dark:text-white hover:text-blue-500 transition-colors">
                                @post.Title
                                @if (post.LikeCount > 0)
                                {
                                    <span class="ml-1 text-xs text-pink-500">[<i data-lucide="heart" class="w-3 h-3 inline"></i>@post.LikeCount]</span>
                                }
                                @if (post.CommentCount > 0)
                                {
                                    <span class="ml-1 text-xs text-blue-500">[@post.CommentCount]</span>
                                }
                            </a>
                        </td>
                        <td class="py-3 px-4 text-center text-gray-600 dark:text-slate-300 text-xs">
                            @post.AuthorNick
                            <br/><span class="text-gray-400 dark:text-slate-500">@Model.Lang.Get("comm.hits") @post.Hits</span>
                        </td>
                        <td class="py-3 px-4 text-center text-xs text-gray-400 dark:text-slate-500">@post.Date</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 페이지네이션 -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-center gap-2 mt-8">
            @if (Model.CurrentPage > 1)
            {
                <a href="/Community?page=@(Model.CurrentPage - 1)@(string.IsNullOrEmpty(Model.Keyword) ? "" : "&keyword=" + Model.Keyword)"
                   class="px-4 py-2 bg-white dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-sm font-bold hover:bg-gray-50 dark:hover:bg-slate-700 transition-all dark:text-slate-300">
                    @Model.Lang.Get("comm.prev")
                </a>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                string active = i == Model.CurrentPage
                    ? "bg-blue-600 text-white border-blue-600"
                    : "bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700";
                <a href="/Community?page=@i@(string.IsNullOrEmpty(Model.Keyword) ? "" : "&keyword=" + Model.Keyword)"
                   class="w-10 h-10 flex items-center justify-center border rounded-xl text-sm font-bold transition-all @active">@i</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="/Community?page=@(Model.CurrentPage + 1)@(string.IsNullOrEmpty(Model.Keyword) ? "" : "&keyword=" + Model.Keyword)"
                   class="px-4 py-2 bg-white dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-sm font-bold hover:bg-gray-50 dark:hover:bg-slate-700 transition-all dark:text-slate-300">
                    @Model.Lang.Get("comm.next")
                </a>
            }
        </div>
    }
</div>

@section Scripts {
<script>lucide.createIcons();</script>
}
