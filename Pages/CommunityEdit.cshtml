@page
@model CommunityEditModel
@{
    ViewData["Title"] = "게시글 수정";
}

<div class="max-w-4xl mx-auto px-6 py-12">
    <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-3xl p-8 shadow-sm">

        <h2 class="text-2xl font-bold mb-8 text-gray-900 dark:text-white">@Model.Lang.Get("edit.title")</h2>

        <form method="post" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="PostNo" value="@Model.PostNo" />
            <!-- 제목 -->
            <div>
                <label class="block text-sm font-semibold mb-2 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("edit.titleLbl")</label>
                <input name="Title" type="text" value="@Model.Title"
                       class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white transition-all" />
            </div>
            <!-- 본문 -->
            <div>
                <label class="block text-sm font-semibold mb-2 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("edit.content")</label>
                <textarea name="Contents" rows="12"
                          class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-white dark:bg-slate-700 dark:text-white transition-all">@Model.Contents</textarea>
            </div>

            <!-- 첨부파일 관리 -->
            <div>
                <label class="block text-sm font-semibold mb-2 ml-1 text-gray-700 dark:text-gray-300">첨부파일</label>

                @if (!string.IsNullOrEmpty(Model.ExistingFileName))
                {
                    <!-- 기존 파일 표시 -->
                    <div id="existingFileBox" class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-slate-700/50 rounded-xl mb-3 border border-gray-200 dark:border-slate-600">
                        <i data-lucide="paperclip" class="w-4 h-4 text-gray-400 shrink-0"></i>
                        <span class="text-sm text-gray-700 dark:text-gray-300 flex-1 truncate">@Model.ExistingFileName</span>
                        <span class="text-xs text-gray-400">@(Model.ExistingFileSize > 1024 ? $"{Model.ExistingFileSize / 1024}KB" : $"{Model.ExistingFileSize}B")</span>
                        <label class="flex items-center gap-2 text-xs text-red-500 cursor-pointer hover:text-red-600 shrink-0">
                            <input type="checkbox" name="DeleteFile" value="true" onchange="toggleFileDelete(this)" class="rounded" />
                            삭제
                        </label>
                    </div>
                }

                <!-- 새 파일 업로드 (파일 교체 또는 새 첨부) -->
                <input name="Upload" type="file" id="fileUpload"
                       class="w-full px-4 py-3 border-2 border-dashed border-gray-200 dark:border-slate-600 rounded-xl hover:border-blue-400 dark:hover:border-blue-500 transition-all cursor-pointer bg-gray-50 dark:bg-slate-700 text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 dark:file:bg-blue-950 file:text-blue-700 dark:file:text-blue-300" />
                <p class="text-xs text-gray-400 mt-1 ml-1">
                    @(string.IsNullOrEmpty(Model.ExistingFileName) ? "파일을 선택하면 첨부됩니다." : "새 파일 선택 시 기존 파일이 교체됩니다.")
                    (최대 10MB, jpg/png/gif/webp/pdf/zip/txt)
                </p>

                <!-- 이미지 미리보기 -->
                <div id="imgPreview" class="hidden mt-3">
                    <img id="previewImg" class="max-h-48 rounded-xl border dark:border-slate-600" />
                </div>
            </div>

            <!-- 버튼 -->
            <div class="flex justify-end gap-4 pt-6 border-t dark:border-slate-700">
                <a href="/Community" class="px-6 py-3 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-xl font-bold hover:bg-gray-200 dark:hover:bg-slate-600 transition-all text-center">
                    @Model.Lang.Get("edit.cancel")
                </a>
                <button type="submit" class="px-10 py-3 bg-blue-600 dark:bg-blue-500 text-white rounded-xl font-bold hover:bg-blue-700 dark:hover:bg-blue-600 transition-all shadow-lg shadow-blue-100 dark:shadow-blue-950 cursor-pointer">
                    @Model.Lang.Get("edit.submit")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    // 파일 삭제 체크 시 취소선 표시
    function toggleFileDelete(cb) {
        var box = document.getElementById('existingFileBox');
        if (cb.checked) {
            box.classList.add('opacity-50');
            box.querySelector('span').classList.add('line-through');
        } else {
            box.classList.remove('opacity-50');
            box.querySelector('span').classList.remove('line-through');
        }
    }

    // 이미지 파일 선택 시 미리보기
    document.getElementById('fileUpload').addEventListener('change', function(e) {
        var file = e.target.files[0];
        var preview = document.getElementById('imgPreview');
        var img = document.getElementById('previewImg');
        if (file && file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function(ev) {
                img.src = ev.target.result;
                preview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        } else {
            preview.classList.add('hidden');
        }
    });
</script>
}
