<script>
/* 로딩 애니메이션 */
var STEPS = [
  // 10쿼리 × 4초 딜레이 = 약 50초 목표
  {id:'s1',pct:3,  msg:'10개 테스트 쿼리 준비 중…',          delay:800},
  {id:'s2',pct:20, msg:'Google · Naver · Daum 병렬 검색 중…',delay:10000},
  {id:'s3',pct:40, msg:'URL 풀 구성 및 중복 제거 중…',       delay:10000},
  {id:'s4',pct:75, msg:'AI 관련성 채점 중… (약 40~50초 소요)',delay:25000},
  {id:'s5',pct:92, msg:'지표 계산 및 집계 중…',              delay:8000}
];
var si = 0, tm;
function advStep() {
  if (si >= STEPS.length) return;
  var st = STEPS[si];
  if (si > 0) document.getElementById(STEPS[si-1].id).className = 'ld-step done';
  document.getElementById(st.id).className = 'ld-step active';
  document.getElementById('pf').style.width = st.pct + '%';
  document.getElementById('ldmsg').textContent = st.msg;
  si++;
  tm = setTimeout(advStep, st.delay);
}
advStep();

function css(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }

/* 평가 실행 (Eval 핸들러 호출) */
fetch('/Eval?handler=Run&n=20')
  .then(function(r) { return r.text(); })
  .then(function(txt) {
    clearTimeout(tm);
    document.getElementById('pf').style.width = '100%';
    document.getElementById('ldmsg').textContent = '완료! 결과를 렌더링 중…';
    STEPS.forEach(function(st) { document.getElementById(st.id).className = 'ld-step done'; });

    if (txt.trim().startsWith('<')) {
      showError('서버 오류:\n' + txt.replace(/<[^>]+>/g,' ').replace(/\s{2,}/g,' ').trim().substring(0, 400));
      return;
    }
    var data;
    try { data = JSON.parse(txt); } catch(e) { showError('JSON 파싱 오류: ' + e.message); return; }
    if (data.error) { showError(data.error); return; }

    setTimeout(function() {
      document.getElementById('loading').style.display = 'none';
      // Chart.js는 canvas가 화면에 보여야 초기화됨 → main 먼저 표시 후 render
      document.getElementById('main').style.display = 'block';
      try {
        render(data);
      } catch(e) {
        // render() 중 JS 예외 → 에러 박스 표시
        document.getElementById('main').style.display = 'none';
        showError('렌더링 오류: ' + e.message + '\n' + (e.stack || ''));
      }
    }, 600);
  })
  .catch(function(e) { showError('네트워크 오류 (서버 응답 없음 또는 timeout): ' + e.message); });

function showError(msg) {
  clearTimeout(tm);
  try { document.getElementById('loading').style.display = 'none'; } catch(e) {}
  try {
    document.getElementById('error-box').style.display = 'block';
    // 긴 에러 메시지는 앞 300자만 표시
    document.getElementById('err-msg').textContent = String(msg).substring(0, 300);
  } catch(e) {
    // 최후 수단: body에 에러 직접 표시
    document.body.innerHTML = '<div style="margin:40px;color:red;font-family:monospace;white-space:pre-wrap">오류: ' + String(msg).substring(0, 500) + '</div>';
  }
}

function render(data) {
  // 데이터 구조 검증 — aggregate 없으면 에러 표시
  if (!data || !data.aggregate || !data.aggregate.nDCG10) {
    showError('서버 응답 데이터 오류: aggregate 없음\n' + JSON.stringify(data).substring(0, 300));
    return;
  }
  var agg = data.aggregate, bq = data.byQuery || [], valid = data.queryCount;
  var zeros = 0;
  bq.forEach(function(r) { if (!r.nDCG10) zeros++; });

  var now = new Date();
  document.getElementById('eval-meta').textContent =
    '평가 일시: ' + now.getFullYear() + '.' + (now.getMonth()+1) + '.' + now.getDate() +
    '  |  유효 쿼리: ' + valid + '/' + bq.length +
    '  |  평가 지표: nDCG@10 · MRR · P@5';

  /* 타일 */
  var hasBrave = agg.nDCG10.Brave != null;
  var engines = [
    {k:'g',name:'Google',   ndcg:agg.nDCG10.Google, mrr:agg.MRR.Google, p5:agg.P5.Google},
    {k:'n',name:'Naver',    ndcg:agg.nDCG10.Naver,  mrr:agg.MRR.Naver,  p5:agg.P5.Naver},
    {k:'d',name:'Daum',     ndcg:agg.nDCG10.Daum,   mrr:agg.MRR.Daum,   p5:agg.P5.Daum},
    {k:'r',name:'RRF 통합', ndcg:agg.nDCG10.RRF,    mrr:agg.MRR.RRF,    p5:agg.P5.RRF}
  ];
  if (hasBrave) engines.splice(3, 0, {k:'b',name:'Brave', ndcg:agg.nDCG10.Brave, mrr:agg.MRR.Brave, p5:agg.P5.Brave});
  var sorted = engines.slice().sort(function(a,b){return b.ndcg-a.ndcg;});
  sorted.forEach(function(e,i){e.rank=i+1;});
  var rankLabels = ['','1위 🥇','2위 🥈','3위 🥉','4위'];
  var tc = document.getElementById('tiles');
  engines.forEach(function(e) {
    var rc = e.rank===1?'gold':e.rank===2?'silver':e.rank===3?'bronze':'';
    tc.innerHTML += '<div class="tile '+e.k+'">' +
      '<div class="tile-eng">'+e.name+'</div>' +
      '<div class="tile-val">'+e.ndcg.toFixed(4)+'</div>' +
      '<div class="tile-lbl">nDCG@10</div>' +
      '<div class="tile-sub">MRR <span>'+e.mrr.toFixed(4)+'</span> &nbsp; P@5 <span>'+e.p5.toFixed(4)+'</span></div>' +
      '<span class="badge-rank '+rc+'">'+rankLabels[e.rank]+'</span>' +
      '</div>';
  });

  /* 개선율 */
  var maxV = Math.max(agg.nDCG10.Naver, agg.nDCG10.Daum, agg.nDCG10.RRF) * 1.2;
  var rows = [
    {k:'n',name:'Naver',v:agg.nDCG10.Naver,c:'var(--N)',base:null},
    {k:'d',name:'Daum', v:agg.nDCG10.Daum, c:'var(--D)',base:null},
    {k:'r',name:'RRF',  v:agg.nDCG10.RRF,  c:'var(--R)',base:Math.max(agg.nDCG10.Naver,agg.nDCG10.Daum)}
  ];
  if (hasBrave) rows.splice(2, 0, {k:'b',name:'Brave',v:agg.nDCG10.Brave,c:'var(--B)',base:null});
  var ir = document.getElementById('improve-rows');
  rows.forEach(function(row) {
    var pct = Math.round(row.v / maxV * 100);
    var delta = '';
    if (row.base !== null) {
      var diff = row.v - row.base;
      delta = '<span class="imp-delta" style="color:'+(diff>=0?'var(--ok)':'var(--err)')+'">'+(diff>=0?'+':'')+(diff*100).toFixed(2)+'%</span>';
    } else {
      delta = '<span class="imp-delta" style="color:var(--mu)">기준</span>';
    }
    ir.innerHTML += '<div class="imp-row">' +
      '<span class="imp-eng '+row.k+'">'+row.name+'</span>' +
      '<div class="imp-track"><div class="imp-fill" style="width:'+pct+'%;background:'+row.c+'"><span class="imp-fill-v">'+row.v.toFixed(4)+'</span></div></div>' +
      delta + '</div>';
  });

  /* 차트 */
  function mkBar(id, vals) {
    var labels = hasBrave ? ['Google','Naver','Daum','Brave','RRF'] : ['Google','Naver','Daum','RRF'];
    var data   = hasBrave ? [vals.G,vals.N,vals.D,vals.B,vals.R] : [vals.G,vals.N,vals.D,vals.R];
    var colors = hasBrave ? [css('--G'),css('--N'),css('--D'),css('--B'),css('--R')] : [css('--G'),css('--N'),css('--D'),css('--R')];
    return new Chart(document.getElementById(id), {
      type:'bar',
      data:{labels,
        datasets:[{data,
          backgroundColor:colors,borderRadius:4,borderSkipped:false}]},
      options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
        scales:{
          x:{min:0,max:Math.min(1,Math.max(vals.G,vals.N,vals.D,vals.R)*1.15),
            ticks:{color:css('--mu'),font:{size:10}},grid:{color:css('--bd')}},
          y:{ticks:{color:css('--fg'),font:{size:11,family:"'Noto Sans KR',sans-serif"}},grid:{display:false}}
        },
        plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return ' '+ctx.raw.toFixed(4)}}}}
      }
    });
  }
  mkBar('c-ndcg',{G:agg.nDCG10.Google,N:agg.nDCG10.Naver,D:agg.nDCG10.Daum,B:agg.nDCG10.Brave||0,R:agg.nDCG10.RRF});
  mkBar('c-mrr', {G:agg.MRR.Google,   N:agg.MRR.Naver,   D:agg.MRR.Daum,   B:agg.MRR.Brave||0,   R:agg.MRR.RRF});
  mkBar('c-p5',  {G:agg.P5.Google,    N:agg.P5.Naver,    D:agg.P5.Daum,    B:agg.P5.Brave||0,    R:agg.P5.RRF});

  /* 테이블 */
  document.getElementById('valid-count').textContent = '유효: '+valid+'개 / 0점(레이블 실패): '+zeros+'개';
  // Brave 컬럼 표시 여부
  if (hasBrave) document.getElementById('th-brave').style.display = '';
  var tb = document.getElementById('qtbody');
  bq.forEach(function(row) {
    // AI 레이블링 성공 여부 표시
    var lbl = (row.labeledCount != null)
      ? (row.labeledCount === 0
          ? '<span style="color:var(--err)">실패(0/'+row.poolSize+')</span>'
          : '<span style="color:var(--ok)">'+row.labeledCount+'/'+row.poolSize+'</span>')
      : '—';
    if (!row.nDCG10) {
      var colspan = hasBrave ? '5' : '4';
      tb.innerHTML += '<tr class="zero-row"><td>'+row.query+'</td><td><span class="kw">'+(row.keyword||'—')+'</span></td>' +
        '<td class="num">'+lbl+'</td>' +
        '<td colspan="'+colspan+'" class="num" style="text-align:center">AI 레이블링 실패</td><td class="num">—</td></tr>';
      return;
    }
    var g=row.nDCG10.Google,n=row.nDCG10.Naver,d=row.nDCG10.Daum;
    var b=row.nDCG10.Brave||0,r=row.nDCG10.RRF;
    var best=hasBrave?Math.max(g,n,d,b,r):Math.max(g,n,d,r);
    var wc=g===best?'g':n===best?'n':d===best?'d':(hasBrave&&b===best)?'b':'r';
    var wl={g:'Google',n:'Naver',d:'Daum',b:'Brave',r:'RRF'};
    function nc(v,cls,hidden){return '<td class="num'+(cls?' win '+cls:'')+'"'+(hidden?' style="display:none"':'')+'>'+v.toFixed(4)+'</td>';}
    tb.innerHTML += '<tr><td>'+row.query+'</td><td><span class="kw">'+(row.keyword||'—')+'</span></td>' +
      '<td class="num">'+lbl+'</td>' +
      nc(g,wc==='g'?'g':null)+nc(n,wc==='n'?'n':null)+nc(d,wc==='d'?'d':null) +
      nc(b,wc==='b'?'b':null,!hasBrave) +
      nc(r,wc==='r'?'r':null) +
      '<td class="num win '+wc+'">'+wl[wc]+'</td></tr>';
  });

  /* 핵심 발견 */
  var rrf=agg.nDCG10.RRF, nav=agg.nDCG10.Naver, dau=agg.nDCG10.Daum;
  var imp = ((rrf - Math.max(nav,dau))*100).toFixed(2);
  var sign = parseFloat(imp)>=0?'+':'';
  document.getElementById('findings').innerHTML =
    '<div class="fin green"><div class="fin-n">발견 #1</div>' +
    '<div class="fin-t">RRF는 단일 Naver/Daum 대비 nDCG 기준 '+sign+imp+'% 차이</div>' +
    '<div class="fin-v">RRF '+rrf.toFixed(4)+'</div>' +
    '<div class="fin-d">세 엔진 합의 기반 재정렬로 신뢰도 높은 결과를 상위에 배치. 커버리지도 더 넓음.</div></div>' +
    '<div class="fin purple"><div class="fin-n">발견 #2</div>' +
    '<div class="fin-t">RRF는 "합의된" 결과를 우선 보여줍니다</div>' +
    '<div class="fin-v">3엔진 교차 검증</div>' +
    '<div class="fin-d">여러 엔진 모두 상위에 오른 결과 = 더 신뢰할 수 있는 결과. 단일 엔진은 이 교차 검증이 불가능.</div></div>' +
    '<div class="fin blue"><div class="fin-n">발견 #3</div>' +
    '<div class="fin-t">한국어 쿼리는 네이버 가중치 1.4 적용</div>' +
    '<div class="fin-v">Google '+agg.nDCG10.Google.toFixed(4)+'</div>' +
    '<div class="fin-d">한국어 쿼리 감지 시 네이버 RRF 가중치를 1.4로 높여 국내 검색 품질을 강화했습니다.</div></div>';

  document.getElementById('footnote').innerHTML =
    '* 관련성 레이블: Groq (qwen/qwen3.8-27b)가 각 결과를 0(무관련)·1(부분관련)·2(매우관련)으로 자동 평가. ' +
    zeros+'개 쿼리는 AI 레이블러 응답 실패로 0점 처리됨 (결과 품질과 무관). ' +
    '평가 대상: 쇼핑·국내뉴스·IT기술·국내장소·게임·스포츠·의료건강·차량·맛집·해외뉴스 10개 카테고리.';
}
</script>
</body>
</html>
