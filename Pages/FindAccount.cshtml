@page
@model FindAccountModel
@{
    ViewData["Title"] = "계정 찾기 - 아이디/비밀번호 찾기";
}

@section HeadContent {
    <meta name="description" content="Meta Search 아이디 찾기, 비밀번호 찾기 - 이메일 인증으로 계정을 복구하세요." />
}

<!-- 계정 찾기 페이지 -->
<div class="flex items-center justify-center min-h-[80vh] px-4">
    <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-3xl p-8 shadow-sm w-full max-w-md">

        <!-- 탭 전환 -->
        <div class="flex gap-2 mb-6">
            <button onclick="switchFindTab('id')" id="tabFindId"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold transition-all">아이디 찾기</button>
            <button onclick="switchFindTab('pw')" id="tabFindPw"
                class="flex-1 py-2.5 rounded-xl text-sm font-bold transition-all">비밀번호 찾기</button>
        </div>

        <!-- ===== 아이디 찾기 탭 ===== -->
        <div id="panelFindId">
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">가입 시 등록한 이메일로 아이디를 찾을 수 있습니다.</p>

            <!-- 이메일 입력 + 인증코드 발송 -->
            <div class="space-y-3">
                <div class="flex gap-2">
                    <input id="findIdEmail" type="email" placeholder="가입한 이메일"
                        class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white text-sm" />
                    <button type="button" id="findIdSendBtn" onclick="findIdSendCode()"
                        class="px-4 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-blue-700 transition-all">인증코드</button>
                </div>

                <!-- 인증코드 입력 (발송 후 표시) -->
                <div id="findIdCodeWrap" class="hidden">
                    <div class="flex gap-2">
                        <input id="findIdCode" type="text" maxlength="6" placeholder="6자리 인증코드"
                            class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-green-500 bg-white dark:bg-slate-700 dark:text-white text-center tracking-widest font-mono text-lg" />
                        <button type="button" onclick="findIdVerify()"
                            class="px-4 py-3 bg-green-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-green-700 transition-all">확인</button>
                    </div>
                    <p id="findIdMsg" class="text-xs mt-1 ml-1 text-gray-400"></p>
                </div>

                <!-- 결과 표시 영역 -->
                <div id="findIdResult" class="hidden p-4 bg-blue-50 dark:bg-blue-950 rounded-xl text-center">
                    <p class="text-sm text-gray-600 dark:text-slate-300 mb-1">회원님의 아이디는</p>
                    <p class="text-xl font-bold text-blue-600 dark:text-blue-400" id="findIdValue"></p>
                    <p class="text-xs text-gray-400 dark:text-slate-500 mt-1">개인정보 보호를 위해 일부 문자가 마스킹되어 있습니다.</p>
                </div>
            </div>

            <div class="mt-6 flex gap-3">
                <a href="/" class="flex-1 py-3 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-xl font-bold text-center text-sm hover:bg-gray-200 dark:hover:bg-slate-600 transition-all">홈으로</a>
                <button type="button" onclick="switchFindTab('pw')" class="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 transition-all">비밀번호 찾기</button>
            </div>
        </div>

        <!-- ===== 비밀번호 찾기 탭 ===== -->
        <div id="panelFindPw" class="hidden">
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">아이디와 이메일을 입력하면 비밀번호를 재설정할 수 있습니다.</p>

            <div class="space-y-3">
                <!-- 아이디 입력 -->
                <input id="findPwId" type="text" placeholder="아이디"
                    class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white text-sm" />

                <!-- 이메일 + 인증코드 -->
                <div class="flex gap-2">
                    <input id="findPwEmail" type="email" placeholder="가입한 이메일"
                        class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white text-sm" />
                    <button type="button" id="findPwSendBtn" onclick="findPwSendCode()"
                        class="px-4 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-blue-700 transition-all">인증코드</button>
                </div>

                <!-- 인증코드 입력 -->
                <div id="findPwCodeWrap" class="hidden">
                    <div class="flex gap-2">
                        <input id="findPwCode" type="text" maxlength="6" placeholder="6자리 인증코드"
                            class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-green-500 bg-white dark:bg-slate-700 dark:text-white text-center tracking-widest font-mono text-lg" />
                        <button type="button" onclick="findPwVerify()"
                            class="px-4 py-3 bg-green-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-green-700 transition-all">확인</button>
                    </div>
                    <p id="findPwMsg" class="text-xs mt-1 ml-1 text-gray-400"></p>
                </div>

                <!-- 새 비밀번호 입력 (인증 완료 후 표시) -->
                <div id="findPwNewWrap" class="hidden space-y-3">
                    <div class="p-3 bg-green-50 dark:bg-green-950 rounded-xl">
                        <p class="text-sm text-green-600 dark:text-green-400 font-bold text-center">이메일 인증 완료! 새 비밀번호를 설정하세요.</p>
                    </div>
                    <input id="findPwNew" type="password" placeholder="새 비밀번호" oninput="checkFindPwPolicy()"
                        class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white text-sm" />
                    <input id="findPwNewConfirm" type="password" placeholder="새 비밀번호 확인"
                        class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white text-sm" />
                    <!-- 비밀번호 정책 -->
                    <div class="text-xs space-y-0.5 px-1">
                        <p id="fpPwLen" class="text-gray-400">● 8자 이상</p>
                        <p id="fpPwAlpha" class="text-gray-400">● 영문 포함</p>
                        <p id="fpPwNum" class="text-gray-400">● 숫자 포함</p>
                        <p id="fpPwSpec" class="text-gray-400">● 특수문자 포함</p>
                    </div>
                    <button type="button" onclick="findPwReset()"
                        class="w-full py-3 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 transition-all">비밀번호 변경</button>
                </div>
            </div>

            <div class="mt-6 flex gap-3">
                <a href="/" class="flex-1 py-3 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-xl font-bold text-center text-sm hover:bg-gray-200 dark:hover:bg-slate-600 transition-all">홈으로</a>
                <button type="button" onclick="switchFindTab('id')" class="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 transition-all">아이디 찾기</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 초기 탭 설정
    var initialTab = '@Model.InitialTab';
    switchFindTab(initialTab);

    // 탭 전환
    function switchFindTab(tab) {
        var activeClass = 'bg-blue-600 text-white';
        var inactiveClass = 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300';
        if (tab === 'id') {
            document.getElementById('panelFindId').classList.remove('hidden');
            document.getElementById('panelFindPw').classList.add('hidden');
            document.getElementById('tabFindId').className = 'flex-1 py-2.5 rounded-xl text-sm font-bold transition-all ' + activeClass;
            document.getElementById('tabFindPw').className = 'flex-1 py-2.5 rounded-xl text-sm font-bold transition-all ' + inactiveClass;
        } else {
            document.getElementById('panelFindId').classList.add('hidden');
            document.getElementById('panelFindPw').classList.remove('hidden');
            document.getElementById('tabFindPw').className = 'flex-1 py-2.5 rounded-xl text-sm font-bold transition-all ' + activeClass;
            document.getElementById('tabFindId').className = 'flex-1 py-2.5 rounded-xl text-sm font-bold transition-all ' + inactiveClass;
        }
    }

    // ── 아이디 찾기 ──

    // 인증코드 발송
    function findIdSendCode() {
        var email = document.getElementById('findIdEmail').value.trim();
        if (!email || !email.includes('@@')) { alert('올바른 이메일을 입력해주세요.'); return; }

        var btn = document.getElementById('findIdSendBtn');
        btn.disabled = true;
        btn.textContent = '확인 중...';

        fetch('/api/account/find-id', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.result === 'ok') {
                document.getElementById('findIdCodeWrap').classList.remove('hidden');
                document.getElementById('findIdMsg').textContent = '인증코드가 발송되었습니다. 5분 이내에 입력해주세요.';
                document.getElementById('findIdMsg').className = 'text-xs mt-1 ml-1 text-blue-500';
                // 쿨다운 60초
                var sec = 60;
                var timer = setInterval(function() {
                    sec--;
                    btn.textContent = sec + '초';
                    if (sec <= 0) { clearInterval(timer); btn.disabled = false; btn.textContent = '재발송'; }
                }, 1000);
            } else {
                var msg = '이메일 발송에 실패했습니다.';
                if (d.result === 'not_found') msg = '해당 이메일로 가입된 계정이 없습니다.';
                else if (d.result === 'rate_limited') msg = '요청이 너무 많습니다. 잠시 후 다시 시도해주세요.';
                alert(msg);
                btn.disabled = false;
                btn.textContent = '인증코드';
            }
        })
        .catch(function() { alert('서버 오류'); btn.disabled = false; btn.textContent = '인증코드'; });
    }

    // 인증코드 확인 → 마스킹된 아이디 표시
    function findIdVerify() {
        var email = document.getElementById('findIdEmail').value.trim();
        var code = document.getElementById('findIdCode').value.trim();
        if (code.length !== 6) { alert('6자리 코드를 입력해주세요.'); return; }

        fetch('/api/account/find-id/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, code: code })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.result === 'ok') {
                document.getElementById('findIdResult').classList.remove('hidden');
                document.getElementById('findIdValue').textContent = d.userid;
                document.getElementById('findIdCodeWrap').classList.add('hidden');
            } else {
                document.getElementById('findIdMsg').textContent = '인증코드가 일치하지 않거나 만료되었습니다.';
                document.getElementById('findIdMsg').className = 'text-xs mt-1 ml-1 text-red-500';
            }
        });
    }

    // ── 비밀번호 찾기 ──

    // 인증코드 발송
    function findPwSendCode() {
        var userid = document.getElementById('findPwId').value.trim();
        var email = document.getElementById('findPwEmail').value.trim();
        if (!userid) { alert('아이디를 입력해주세요.'); return; }
        if (!email || !email.includes('@@')) { alert('올바른 이메일을 입력해주세요.'); return; }

        var btn = document.getElementById('findPwSendBtn');
        btn.disabled = true;
        btn.textContent = '확인 중...';

        fetch('/api/account/find-pw', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userid: userid, email: email })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.result === 'ok') {
                document.getElementById('findPwCodeWrap').classList.remove('hidden');
                document.getElementById('findPwMsg').textContent = '인증코드가 발송되었습니다. 5분 이내에 입력해주세요.';
                document.getElementById('findPwMsg').className = 'text-xs mt-1 ml-1 text-blue-500';
                var sec = 60;
                var timer = setInterval(function() {
                    sec--;
                    btn.textContent = sec + '초';
                    if (sec <= 0) { clearInterval(timer); btn.disabled = false; btn.textContent = '재발송'; }
                }, 1000);
            } else {
                var msg = '이메일 발송에 실패했습니다.';
                if (d.result === 'not_found') msg = '아이디와 이메일이 일치하는 계정이 없습니다.';
                else if (d.result === 'rate_limited') msg = '요청이 너무 많습니다. 잠시 후 다시 시도해주세요.';
                else if (d.result === 'invalid_input') msg = '아이디와 이메일을 모두 입력해주세요.';
                alert(msg);
                btn.disabled = false;
                btn.textContent = '인증코드';
            }
        })
        .catch(function() { alert('서버 오류'); btn.disabled = false; btn.textContent = '인증코드'; });
    }

    // 인증코드 확인 → 새 비밀번호 입력 영역 표시
    function findPwVerify() {
        var email = document.getElementById('findPwEmail').value.trim();
        var code = document.getElementById('findPwCode').value.trim();
        if (code.length !== 6) { alert('6자리 코드를 입력해주세요.'); return; }

        fetch('/api/account/find-pw/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, code: code })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.result === 'ok') {
                document.getElementById('findPwCodeWrap').classList.add('hidden');
                document.getElementById('findPwNewWrap').classList.remove('hidden');
                // 아이디/이메일 입력 비활성화
                document.getElementById('findPwId').readOnly = true;
                document.getElementById('findPwEmail').readOnly = true;
                document.getElementById('findPwSendBtn').disabled = true;
            } else {
                document.getElementById('findPwMsg').textContent = '인증코드가 일치하지 않거나 만료되었습니다.';
                document.getElementById('findPwMsg').className = 'text-xs mt-1 ml-1 text-red-500';
            }
        });
    }

    // 비밀번호 정책 실시간 검증
    function checkFindPwPolicy() {
        var pw = document.getElementById('findPwNew').value;
        var ok = 'text-green-500 font-bold';
        var ng = 'text-gray-400';
        document.getElementById('fpPwLen').className = pw.length >= 8 ? ok : ng;
        document.getElementById('fpPwAlpha').className = /[A-Za-z]/.test(pw) ? ok : ng;
        document.getElementById('fpPwNum').className = /[0-9]/.test(pw) ? ok : ng;
        document.getElementById('fpPwSpec').className = /[^A-Za-z0-9]/.test(pw) ? ok : ng;
    }

    // 새 비밀번호 설정
    function findPwReset() {
        var userid = document.getElementById('findPwId').value.trim();
        var newPw = document.getElementById('findPwNew').value;
        var newPwConfirm = document.getElementById('findPwNewConfirm').value;

        // 비밀번호 정책 검증
        if (newPw.length < 8 || !/[A-Za-z]/.test(newPw) || !/[0-9]/.test(newPw) || !/[^A-Za-z0-9]/.test(newPw)) {
            alert('비밀번호는 8자 이상, 영문+숫자+특수문자를 포함해야 합니다.');
            return;
        }
        if (newPw !== newPwConfirm) {
            alert('비밀번호가 일치하지 않습니다.');
            return;
        }

        fetch('/api/account/find-pw/reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userid: userid, newPw: newPw })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.result === 'ok') {
                alert('비밀번호가 변경되었습니다. 새 비밀번호로 로그인해주세요.');
                window.location.href = '/';
            } else if (d.result === 'weak_password') {
                alert('비밀번호는 8자 이상, 영문+숫자+특수문자를 포함해야 합니다.');
            } else if (d.result === 'unauthorized') {
                alert('인증이 만료되었습니다. 다시 시도해주세요.');
                location.reload();
            } else {
                alert('비밀번호 변경에 실패했습니다.');
            }
        });
    }
</script>
}
