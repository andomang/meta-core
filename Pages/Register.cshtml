@page
@model RegisterModel
@{
    ViewData["Title"] = "무료 회원가입 - 이메일 인증";
}

@section HeadContent {
    <meta name="description" content="Meta Search 무료 회원가입 - 이메일 인증으로 간편하게 가입하고 통합 검색, 커뮤니티, 경험 평가 등 모든 기능을 무료로 이용하세요. 개인정보 보호와 보안을 최우선으로 합니다." />
}

<!-- 회원가입 폼 -->
<div class="flex items-center justify-center min-h-[80vh] px-4">
    <div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-3xl p-8 shadow-sm w-full max-w-md">

        <h2 class="text-2xl font-bold mb-8 text-center text-gray-900 dark:text-white">@Model.Lang.Get("reg.title")</h2>

        <!-- 서버 오류 메시지 표시 -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-4 p-3 bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-400 text-sm rounded-xl text-center">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-4">
            <!-- 아이디 + 중복확인 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("reg.id")</label>
                <div class="flex gap-2">
                    <input id="idInput" name="Userid" type="text" value="@Model.Input.Userid" required
                           class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
                    <button type="button" id="checkIdBtn" onclick="checkId()"
                            class="px-4 py-3 bg-gray-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-gray-700 transition-all">중복확인</button>
                </div>
                <p id="idMsg" class="text-xs mt-1 ml-1 hidden"></p>
            </div>
            <!-- 비밀번호 + 정책 안내 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("reg.pw")</label>
                <input id="pwInput" name="Passwd" type="password" required oninput="checkRegPwPolicy()"
                       class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
                <div id="regPwPolicy" class="text-xs space-y-0.5 px-1 mt-1">
                    <p id="regPwLen" class="text-gray-400">● 8자 이상</p>
                    <p id="regPwAlpha" class="text-gray-400">● 영문 포함</p>
                    <p id="regPwNum" class="text-gray-400">● 숫자 포함</p>
                    <p id="regPwSpec" class="text-gray-400">● 특수문자 포함</p>
                </div>
            </div>
            <!-- 비밀번호 확인 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">비밀번호 확인</label>
                <input id="pwConfirmInput" name="PasswdConfirm" type="password" required
                       class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
                <p id="pwMatchMsg" class="text-xs mt-1 ml-1 hidden"></p>
            </div>
            <!-- 이름 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("reg.name")</label>
                <input name="Name" type="text" value="@Model.Input.Name" required
                       class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
            </div>
            <!-- 닉네임 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("reg.nick")</label>
                <input name="Nickname" type="text" value="@Model.Input.Nickname" required
                       class="w-full px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
            </div>
            <!-- 이메일 + 인증 -->
            <div>
                <label class="block text-sm font-semibold mb-1 ml-1 text-gray-700 dark:text-gray-300">@Model.Lang.Get("reg.email") <span class="text-red-500">*</span></label>
                <div class="flex gap-2">
                    <input id="emailInput" name="Email" type="email" value="@Model.Input.Email" required
                           class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-slate-700 dark:text-white" />
                    <button type="button" id="sendCodeBtn" onclick="sendCode()"
                            class="px-4 py-3 bg-blue-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-blue-700 transition-all">인증코드</button>
                </div>
            </div>
            <!-- 인증코드 입력 (코드 발송 후 표시) -->
            <div id="codeWrap" class="hidden">
                <div class="flex gap-2">
                    <input id="codeInput" type="text" maxlength="6" placeholder="6자리 인증코드"
                           class="flex-1 px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl outline-none focus:ring-2 focus:ring-green-500 bg-white dark:bg-slate-700 dark:text-white text-center tracking-widest font-mono text-lg" />
                    <button type="button" id="verifyBtn" onclick="verifyCode()"
                            class="px-4 py-3 bg-green-600 text-white rounded-xl font-bold text-sm whitespace-nowrap hover:bg-green-700 transition-all">확인</button>
                </div>
                <p id="codeMsg" class="text-xs mt-1 ml-1 text-gray-400"></p>
            </div>
            <input type="hidden" id="emailVerified" name="EmailVerified" value="false" />
            <!-- 버튼 영역 -->
            <div class="flex gap-3 pt-4">
                <a href="/" class="flex-1 py-3 bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-xl font-bold text-center hover:bg-gray-200 dark:hover:bg-slate-600 transition-all">
                    @Model.Lang.Get("reg.cancel")
                </a>
                <button type="submit" id="submitBtn" onclick="return checkVerified()"
                        class="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold cursor-pointer hover:bg-blue-700 transition-all">
                    @Model.Lang.Get("reg.submit")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var emailVerified = false;
    var verifiedEmail = '';
    var idChecked = false;
    var checkedId = '';

    // 아이디 중복확인
    function checkId() {
        var id = document.getElementById('idInput').value.trim().toLowerCase();
        var msg = document.getElementById('idMsg');
        if (!id) { alert('아이디를 입력해주세요.'); return; }

        fetch('/api/register/check-id?id=' + encodeURIComponent(id))
        .then(function(r) { return r.json(); })
        .then(function(data) {
            msg.classList.remove('hidden');
            if (data.result === 'ok') {
                idChecked = true;
                checkedId = id;
                msg.textContent = '사용 가능한 아이디입니다.';
                msg.className = 'text-xs mt-1 ml-1 text-green-500 font-bold';
            } else if (data.result === 'invalid_format') {
                idChecked = false;
                msg.textContent = '영문 소문자, 숫자, 밑줄(_)만 사용 가능합니다. (3~20자)';
                msg.className = 'text-xs mt-1 ml-1 text-red-500';
            } else {
                idChecked = false;
                msg.textContent = '이미 사용 중인 아이디입니다.';
                msg.className = 'text-xs mt-1 ml-1 text-red-500';
            }
        });
    }

    // 아이디 변경 시 중복확인 초기화
    document.getElementById('idInput').addEventListener('input', function() {
        idChecked = false;
        checkedId = '';
        document.getElementById('idMsg').classList.add('hidden');
    });

    // 인증코드 발송 (이메일 중복 체크 포함)
    function sendCode() {
        var email = document.getElementById('emailInput').value.trim();
        if (!email || !email.includes('@@')) {
            alert('올바른 이메일을 입력해주세요.');
            return;
        }
        var btn = document.getElementById('sendCodeBtn');
        btn.disabled = true;
        btn.textContent = '확인 중...';

        fetch('/api/email/send-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.result === 'ok') {
                document.getElementById('codeWrap').classList.remove('hidden');
                document.getElementById('codeMsg').textContent = '인증코드가 발송되었습니다. 5분 이내에 입력해주세요.';
                document.getElementById('codeMsg').className = 'text-xs mt-1 ml-1 text-blue-500';
                // 60초 쿨다운
                var sec = 60;
                var timer = setInterval(function() {
                    sec--;
                    btn.textContent = sec + '초';
                    if (sec <= 0) {
                        clearInterval(timer);
                        btn.disabled = false;
                        btn.textContent = '재발송';
                    }
                }, 1000);
            } else {
                var errMsg = '이메일 발송에 실패했습니다. 잠시 후 다시 시도해주세요.';
                if (data.result === 'invalid_email') errMsg = '올바른 이메일을 입력해주세요.';
                else if (data.result === 'duplicate_email') errMsg = '이미 가입된 이메일입니다.';
                alert(errMsg);
                btn.disabled = false;
                btn.textContent = '인증코드';
            }
        })
        .catch(function() {
            alert('서버 오류가 발생했습니다.');
            btn.disabled = false;
            btn.textContent = '인증코드';
        });
    }

    // 인증코드 확인
    function verifyCode() {
        var email = document.getElementById('emailInput').value.trim();
        var code = document.getElementById('codeInput').value.trim();
        if (code.length !== 6) { alert('6자리 코드를 입력해주세요.'); return; }

        fetch('/api/email/verify-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, code: code })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.result === 'ok') {
                emailVerified = true;
                verifiedEmail = email;
                document.getElementById('emailVerified').value = 'true';
                document.getElementById('codeMsg').textContent = '이메일 인증 완료!';
                document.getElementById('codeMsg').className = 'text-xs mt-1 ml-1 text-green-500 font-bold';
                document.getElementById('codeInput').disabled = true;
                document.getElementById('verifyBtn').disabled = true;
                document.getElementById('verifyBtn').textContent = '완료';
                document.getElementById('emailInput').readOnly = true;
                document.getElementById('sendCodeBtn').disabled = true;
            } else {
                document.getElementById('codeMsg').textContent = '인증코드가 일치하지 않거나 만료되었습니다.';
                document.getElementById('codeMsg').className = 'text-xs mt-1 ml-1 text-red-500';
            }
        });
    }

    // 비밀번호 정책 실시간 검증
    function checkRegPwPolicy() {
        var pw = document.getElementById('pwInput').value;
        var ok = 'text-green-500 font-bold';
        var ng = 'text-gray-400';
        document.getElementById('regPwLen').className = pw.length >= 8 ? ok : ng;
        document.getElementById('regPwAlpha').className = /[A-Za-z]/.test(pw) ? ok : ng;
        document.getElementById('regPwNum').className = /[0-9]/.test(pw) ? ok : ng;
        document.getElementById('regPwSpec').className = /[^A-Za-z0-9]/.test(pw) ? ok : ng;
    }

    // 비밀번호 확인 실시간 검증
    (function() {
        var pw = document.getElementById('pwInput');
        var confirm = document.getElementById('pwConfirmInput');
        var msg = document.getElementById('pwMatchMsg');
        function check() {
            if (!confirm.value) { msg.classList.add('hidden'); return; }
            msg.classList.remove('hidden');
            if (pw.value === confirm.value) {
                msg.textContent = '비밀번호가 일치합니다.';
                msg.className = 'text-xs mt-1 ml-1 text-green-500 font-bold';
            } else {
                msg.textContent = '비밀번호가 일치하지 않습니다.';
                msg.className = 'text-xs mt-1 ml-1 text-red-500';
            }
        }
        pw.addEventListener('input', check);
        confirm.addEventListener('input', check);
    })();

    // 폼 제출 시 아이디 중복확인 + 비밀번호 일치 + 이메일 인증 확인
    function checkVerified() {
        // 아이디 중복확인 체크
        var currentId = document.getElementById('idInput').value.trim().toLowerCase();
        if (!idChecked || currentId !== checkedId) {
            alert('아이디 중복확인을 해주세요.');
            return false;
        }
        var pw = document.getElementById('pwInput').value;
        var confirm = document.getElementById('pwConfirmInput').value;
        // 비밀번호 정책 검증
        if (pw.length < 8 || !/[A-Za-z]/.test(pw) || !/[0-9]/.test(pw) || !/[^A-Za-z0-9]/.test(pw)) {
            alert('비밀번호는 8자 이상, 영문+숫자+특수문자를 포함해야 합니다.');
            return false;
        }
        if (pw !== confirm) {
            alert('비밀번호가 일치하지 않습니다.');
            return false;
        }
        if (!emailVerified) {
            alert('이메일 인증을 완료해주세요.');
            return false;
        }
        var currentEmail = document.getElementById('emailInput').value.trim();
        if (currentEmail !== verifiedEmail) {
            alert('인증된 이메일과 다릅니다. 다시 인증해주세요.');
            return false;
        }
        return true;
    }
</script>
}
