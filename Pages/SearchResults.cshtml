        var html = panelHeader('play-circle', 'YouTube 영상', 'YouTube Data API');
        html += '<div class="flex gap-3 overflow-x-auto pb-2">';
        items.forEach(function(v) {
            html += '<a href="https://www.youtube.com/watch?v=' + encodeURIComponent(v.id) + '" target="_blank" rel="noopener"'
                + ' class="flex-shrink-0 w-52 bg-gray-50 dark:bg-slate-700/50 rounded-xl overflow-hidden hover:shadow-md transition-shadow" style="text-decoration:none">'
                + '<div class="relative">'
                + (v.thumb ? '<img src="' + escapeHtml(v.thumb) + '" alt="" class="w-full h-28 object-cover">' : '<div class="w-full h-28 bg-gray-200 dark:bg-slate-600"></div>')
                + '<div class="absolute inset-0 flex items-center justify-center">'
                + '<div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center bg-opacity-90">'
                + '<svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>'
                + '</div></div></div>'
                + '<div class="p-2">'
                + '<div class="text-xs text-gray-800 dark:text-slate-200 font-medium mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">' + escapeHtml(v.title) + '</div>'
                + '<div class="text-xs text-gray-500 dark:text-slate-400 truncate">' + escapeHtml(v.channel||'') + '</div>'
                + '</div></a>';
        });
        html += '</div>';
        return html;
    }

    // 날씨
    function renderWeather(data) {
        if (!data.temp) return '';
        var iconUrl = data.icon ? 'https://openweathermap.org/img/wn/' + data.icon + '@@2x.png' : '';
        var html = panelHeader('cloud-sun', '현재 날씨', 'OpenWeatherMap');
        html += '<div class="flex flex-wrap items-center gap-6">'
            + '<div class="flex items-center gap-2">'
            + (iconUrl ? '<img src="' + iconUrl + '" alt="" class="w-16 h-16 flex-shrink-0">' : '')
            + '<div>'
            + '<div class="text-3xl font-bold text-gray-900 dark:text-white">' + escapeHtml(data.temp) + '°C</div>'
            + '<div class="text-sm text-gray-600 dark:text-slate-300 capitalize">' + escapeHtml(data.desc||'') + '</div>'
            + '<div class="text-xs text-gray-400 dark:text-slate-500">' + escapeHtml(data.city||'') + (data.country ? ' (' + escapeHtml(data.country) + ')' : '') + '</div>'
            + '</div></div>'
            + '<div class="grid grid-cols-2 gap-x-8 gap-y-1.5 text-sm">'
            + '<span class="text-gray-500 dark:text-slate-400">체감온도</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.feels||'') + '°C</span>'
            + '<span class="text-gray-500 dark:text-slate-400">습도</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.humidity||'') + '%</span>'
            + '<span class="text-gray-500 dark:text-slate-400">바람</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.wind||'') + ' m/s</span>'
            + '</div></div>';
        return html;
    }

    // 뉴스 날짜 포맷
    function formatNewsDate(pubStr) {
        if (!pubStr) return '';
        try {
            var d = new Date(pubStr);
            if (isNaN(d.getTime())) return '';
            return (d.getMonth() + 1) + '월 ' + d.getDate() + '일';
        } catch(e) { return ''; }
    }

    // ── 관련 검색어 렌더링 ──
    function renderRelated() {
        var relBtn = document.getElementById('relatedLoadBtn');
        if (!_related || _related.length === 0) {
            if (_query) { relBtn.classList.remove('hidden'); relBtn.classList.add('flex'); }
            return;
        }
        relBtn.classList.add('hidden'); relBtn.classList.remove('flex');
        var panel = document.getElementById('relatedPanel');
        var list  = document.getElementById('relatedList');
        list.innerHTML = _related.map(function(r) {
            return '<a href="/SearchResults?q=' + encodeURIComponent(r) + '"'
                + ' class="flex items-center gap-2 py-1.5 text-sm text-gray-700 dark:text-slate-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">'
                + '<i data-lucide="search" class="w-3 h-3 text-gray-400 flex-shrink-0"></i>'
                + escapeHtml(r) + '</a>';
        }).join('');
        panel.classList.remove('hidden');
        lucide.createIcons();
    }

    // HTML 이스케이프
    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // 속성 이스케이프 (data-* 속성용)
    function escapeAttr(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // ── 북마크 추가 ──
    function addBookmark(btn) {
        var data = {
            title: btn.getAttribute('data-title'),
            url: btn.getAttribute('data-url'),
            description: btn.getAttribute('data-desc'),
            source: btn.getAttribute('data-source')
        };
        fetch('/api/bookmarks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.result === 'ok') {
                btn.innerHTML = '<i data-lucide="bookmark-check" class="w-3.5 h-3.5"></i> 저장됨';
                btn.classList.remove('text-gray-400', 'dark:text-slate-500');
                btn.classList.add('text-orange-500', 'dark:text-orange-400');
                btn.disabled = true;
                lucide.createIcons();
            } else if (res.result === 'duplicate') {
                btn.innerHTML = '<i data-lucide="bookmark-check" class="w-3.5 h-3.5"></i> 이미 저장됨';
                btn.classList.add('text-orange-500', 'dark:text-orange-400');
                lucide.createIcons();
            } else if (res.result === 'unauthorized') {
                if (typeof openLogin === 'function') openLogin();
            }
        })
        .catch(function() {});
    }

    // ── "=" 드롭다운 항목 생성 ──
    function extraSwitchItem(type, icon, label, color, curType) {
        var active = (type === curType);
        var cls = active
            ? 'bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-bold cursor-default'
            : 'text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 cursor-pointer';
        return '<button type="button" ' + (active ? 'disabled' : 'onclick="switchExtra(\'' + type + '\')"')
            + ' class="w-full flex items-center gap-2 px-3 py-2 ' + cls + ' transition-colors">'
            + '<i data-lucide="' + icon + '" class="w-3.5 h-3.5 text-' + color + '-500"></i>'
            + label + (active ? ' <span class="ml-auto text-[10px] opacity-60">현재</span>' : '')
            + '</button>';
    }

    // ── "=" 버튼 토글 ──
    function toggleExtraSwitch() {
        var drop = document.getElementById('extraSwitchDrop');
        if (!drop) return;
        drop.classList.toggle('hidden');
    }

    // ── 드롭다운에서 다른 API 선택 ──
    function switchExtra(type) {
        var drop = document.getElementById('extraSwitchDrop');
        if (drop) drop.classList.add('hidden');
        // 패널에 로딩 표시
        var panel = document.getElementById('extraPanel');
        var wrap = panel.querySelector('.bg-white, .dark\\:bg-slate-800');
        if (wrap) {
            var inner = wrap.querySelectorAll(':scope > div');
            if (inner.length > 1) inner[1].innerHTML = '<div class="flex items-center justify-center gap-2 py-8 text-gray-400 dark:text-slate-500"><div class="w-5 h-5 border-2 border-blue-400 border-t-transparent rounded-full animate-spin"></div> 불러오는 중...</div>';
        }
        fetch('/api/search/extra?q=' + encodeURIComponent(_query) + '&type=' + type)
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.data && res.data !== '{}') {
                    _extra = res.data;
                    renderExtraPanel();
                } else {
                    // 데이터 없으면 원래 패널 유지 + 알림
                    if (wrap) {
                        var inner2 = wrap.querySelectorAll(':scope > div');
                        if (inner2.length > 1) inner2[1].innerHTML = '<div class="text-center py-4 text-sm text-gray-400 dark:text-slate-500">데이터 없음</div>';
                    }
                    setTimeout(function() { renderExtraPanel(); }, 1500);
                }
            })
            .catch(function() {
                renderExtraPanel();
            });
    }

    // ── 드롭다운 외부 클릭 시 닫기 ──
    document.addEventListener('click', function(e) {
        var wrap = document.getElementById('extraSwitchWrap');
        if (wrap && !wrap.contains(e.target)) {
            var drop = document.getElementById('extraSwitchDrop');
            if (drop) drop.classList.add('hidden');
        }
    });

    // ── 부가정보 개별 타입 호출 ──
    function loadExtraType(type, btn) {
        var origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<div class="w-3.5 h-3.5 border-2 border-blue-400 border-t-transparent rounded-full animate-spin"></div> 로딩...';

        fetch('/api/search/extra?q=' + encodeURIComponent(_query) + '&type=' + type)
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.data && res.data !== '{}') {
                    _extra = res.data;
                    renderExtraPanel();
                    // 성공하면 버튼 영역 숨기고 패널 표시
                    document.getElementById('extraButtons').classList.add('hidden');
                } else {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                    // 해당 버튼만 실패 표시
                    btn.classList.add('border-red-300', 'dark:border-red-700');
                    btn.title = '데이터 없음';
                }
            })
            .catch(function() {
                btn.disabled = false;
                btn.innerHTML = origHtml;
                btn.classList.add('border-red-300', 'dark:border-red-700');
                btn.title = '연결 실패';
            });
    }

    // ── 관련 검색어 수동 재호출 ──
    function reloadRelated() {
        var btn = document.getElementById('relatedLoadBtn');
        btn.disabled = true;
        btn.textContent = '불러오는 중...';

        fetch('/api/search/related?q=' + encodeURIComponent(_query))
            .then(function(r) { return r.json(); })
            .then(function(res) {
                try {
                    var arr = JSON.parse(res.related);
                    if (arr && arr.length > 0) {
                        _related = arr;
                        renderRelated();
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = '<i data-lucide="sparkles" class="w-4 h-4"></i> 결과 없음 — 다시 시도';
                        lucide.createIcons();
                    }
                } catch(e) {
                    btn.disabled = false;
                    btn.innerHTML = '<i data-lucide="sparkles" class="w-4 h-4"></i> 다시 시도';
                    lucide.createIcons();
                }
            })
            .catch(function() {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="alert-circle" class="w-4 h-4"></i> 연결 실패 — 다시 시도';
                lucide.createIcons();
            });
    }

    // ── AI 검색 요약 (자동 실행, 실패 시 재시도 버튼) ──
    function loadAiSummary() {
        if (!_query) return;
        var box = document.getElementById('aiSummaryBox');
        var content = document.getElementById('aiSummaryContent');
        var retryBtn = document.getElementById('aiRetryBtn');

        // 로딩 상태 표시
        box.classList.remove('hidden');
        retryBtn.classList.add('hidden');
        content.innerHTML = '<div class="flex items-center gap-2"><div class="w-4 h-4 border-2 border-violet-400 border-t-transparent rounded-full animate-spin"></div><span class="text-violet-400 text-xs">AI가 요약을 생성하고 있습니다...</span></div>';

        fetch('/api/ai-summary?q=' + encodeURIComponent(_query))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.summary) {
                    content.textContent = data.summary;
                } else if (data.limited) {
                    content.innerHTML = '<span class="text-violet-400 text-xs">요청 제한에 도달했습니다. 잠시 후 다시 시도해주세요.</span>';
                    retryBtn.classList.remove('hidden');
                } else {
                    // 요약 실패 → 재시도 버튼 표시
                    box.classList.add('hidden');
                    retryBtn.classList.remove('hidden');
                    lucide.createIcons();
                }
            })
            .catch(function() {
                box.classList.add('hidden');
                retryBtn.classList.remove('hidden');
                retryBtn.querySelector('i') && retryBtn.querySelector('i').setAttribute('data-lucide', 'alert-circle');
                lucide.createIcons();
            });
    }
</script>
}
