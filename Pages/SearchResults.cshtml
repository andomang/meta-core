@page
@model SearchResultsModel
@{
    ViewData["Title"] = Model.Query + " - 검색";
}

<!-- 상단 고정 검색바 -->
<div class="border-b border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-16 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
        <div class="flex items-center gap-4">
            <!-- 검색창 -->
            <div class="flex-1 max-w-2xl flex gap-2 relative" id="searchBox">
                <div class="relative flex-1">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5 z-10"></i>
                    <input type="text" id="topSearchInput" value="@Model.Query" autocomplete="off"
                           class="w-full pl-12 pr-4 py-3 border border-gray-300 dark:border-slate-600 rounded-full shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-slate-800 dark:text-white" />
                    <!-- 자동완성 드롭다운 -->
                    <div id="historyDropdown" class="hidden absolute left-0 right-0 top-full mt-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-2xl shadow-lg z-50 overflow-hidden">
                        <div class="flex items-center px-4 py-3 border-b border-gray-100 dark:border-slate-700">
                            <span id="litRecentLabel" class="text-xs font-semibold text-gray-500 dark:text-slate-400"></span>
                        </div>
                        <ul id="historyList" class="py-1 max-h-64 overflow-y-auto"></ul>
                        <div id="historyEmpty" class="hidden px-4 py-4 text-sm text-gray-400 dark:text-slate-500 text-center"></div>
                    </div>
                </div>
                <button type="button" onclick="doSearch()"
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-full transition-all flex-shrink-0 cursor-pointer">
                    검색
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 메인 컨텐츠 -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- 검색 결과 영역 -->
        <div class="flex-1 min-w-0">
            <!-- 결과 수 + AI 배지 -->
            <div class="flex items-center gap-2 mb-6">
                <p class="text-sm text-gray-600 dark:text-slate-400" id="litResultsLabel"></p>
                <span id="keywordBadge" class="hidden px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold rounded-full border border-blue-200 dark:border-blue-700/50">@Model.Keyword</span>
            </div>

            <!-- Extra 패널 (상단) -->
            <div id="extraPanel" class="hidden mb-6"></div>

            <!-- 전체화면 로딩 오버레이 -->
            <div id="pageLoadingOverlay" class="hidden fixed inset-0 z-[9999] bg-white dark:bg-slate-950 flex flex-col items-center justify-center gap-6">
                <div class="w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                <div class="w-full max-w-xl px-6 space-y-3">
                    <div class="h-5 bg-gray-100 dark:bg-slate-800 rounded-full animate-pulse"></div>
                    <div class="h-4 bg-gray-100 dark:bg-slate-800 rounded-full w-3/4 animate-pulse"></div>
                    <div class="h-4 bg-gray-100 dark:bg-slate-800 rounded-full w-1/2 animate-pulse"></div>
                </div>
            </div>

            <!-- 결과 없음 -->
            <div id="noResults" style="display:none" class="flex-col items-center justify-center py-20 text-center">
                <i data-lucide="search-x" class="w-16 h-16 text-gray-200 dark:text-slate-700 mb-4"></i>
                <p class="text-lg font-bold text-gray-400 dark:text-slate-500">@Model.Lang.Get("sr.noResults")</p>
                <p class="text-sm text-gray-300 dark:text-slate-600 mt-1">다른 검색어를 입력해 보세요.</p>
            </div>

            <!-- 엔진 탭 (밑줄 스타일) -->
            <div class="flex gap-0 mb-6 border-b border-gray-200 dark:border-slate-700">
                <button type="button" class="engine-tab px-4 py-2 text-sm font-medium border-b-2 border-blue-500 text-blue-600 dark:text-blue-400 -mb-px" data-tab="all">전체</button>
                <button type="button" class="engine-tab px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300" data-tab="google">구글</button>
                <button type="button" class="engine-tab px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300" data-tab="naver">네이버</button>
                <button type="button" class="engine-tab px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300" data-tab="daum">다음</button>
                <button type="button" id="braveTab" class="engine-tab px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300" data-tab="brave" style="display:none">Brave</button>
            </div>

            <!-- 결과 목록 -->
            <div id="resultsContainer"></div>
            <!-- 페이지네이션 -->
            <div id="paginationContainer" class="mt-6"></div>
        </div>

        <!-- 사이드바 -->
        <div class="lg:w-80 space-y-6">

            <!-- 인기 검색어 -->
            <div class="bg-gray-50 dark:bg-slate-800 border dark:border-slate-700 rounded-2xl p-6">
                <h3 class="font-semibold mb-4 dark:text-white flex items-center gap-2">
                    <i data-lucide="trending-up" class="w-4 h-4 text-blue-500"></i>
                    @Model.Lang.Get("search.popular")
                </h3>
                @{ int rank = 0; }
                @foreach (var p in Model.PopularSearches)
                {
                    rank++;
                    <div class="flex items-center justify-between py-2 border-b dark:border-slate-700 last:border-0">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold w-5 text-center @(rank <= 3 ? "text-blue-500" : "text-gray-400 dark:text-slate-500")">@rank</span>
                            <a href="/SearchResults?q=@Uri.EscapeDataString((string)p.query)"
                               class="text-sm text-gray-700 dark:text-slate-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">
                                @p.query
                            </a>
                        </div>
                        <span class="text-xs text-gray-400 dark:text-slate-500">@p.searchcount회</span>
                    </div>
                }
                @if (rank == 0)
                {
                    <p class="text-sm text-gray-400 dark:text-slate-500 text-center py-2">검색 기록이 없습니다.</p>
                }
            </div>

            <!-- 관련 검색어 (AI 생성) -->
            <div id="relatedPanel" class="hidden bg-gray-50 dark:bg-slate-800 border dark:border-slate-700 rounded-2xl p-6">
                <h3 class="font-semibold mb-4 dark:text-white flex items-center gap-2">
                    <i data-lucide="search" class="w-4 h-4 text-blue-500"></i>
                    @Model.Lang.Get("sr.related")
                </h3>
                <div id="relatedList" class="space-y-2"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    // ── 서버 데이터 수신 ──
    var _query    = '@Html.Raw(Model.Query.Replace("'", "\\'"))';
    var _keyword  = '@Html.Raw(Model.Keyword)';
    var _results  = @Html.Raw(Model.ResultsJson);   // 전체 RRF 결과
    var _google   = @Html.Raw(Model.GoogleJson);
    var _naver    = @Html.Raw(Model.NaverJson);
    var _daum     = @Html.Raw(Model.DaumJson);
    var _brave    = @Html.Raw(Model.BraveJson);
    var _scores   = @Html.Raw(Model.ScoresJson);
    // Brave 탭 노출 여부 (API 키 설정 시에만 결과 있음)
    if (_brave && _brave.length > 0) document.getElementById('braveTab').style.display = '';
    var _extra    = '@Html.Raw(Model.ExtraJson.Replace("'", "\\'"))';
    var _related  = @Html.Raw(Model.RelatedJson);
    var _ranked   = @Html.Raw(Model.RankedJson);    // AI 재정렬 상위 10개

    // ── 페이지네이션 상태 ──
    var PAGE_SIZE      = 10;
    var activeItems    = [];
    var currentPage    = 1;
    var activeTab      = 'all';
    var isLoadingBatch = false;
    var batchCount     = 0;  // 배치 로드 횟수 (최대 3번 = batch=2,3,4)

    // ── 초기화 ──
    document.getElementById('keywordBadge').classList.remove('hidden');
    renderExtraPanel();
    renderRelated();

    // 초기 탭 결과 세팅
    activeItems = getAllItems();
    renderResultsPage();

    // ── 검색 실행 ──
    function doSearch() {
        var q = document.getElementById('topSearchInput').value.trim();
        if (!q) return;
        document.getElementById('pageLoadingOverlay').classList.remove('hidden');
        window.location.href = '/SearchResults?q=' + encodeURIComponent(q);
    }
    document.getElementById('topSearchInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
    });

    // ── 자동완성/기록 드롭다운 ──
    var _suggestTimer;
    var searchInput = document.getElementById('topSearchInput');
    var dropdown    = document.getElementById('historyDropdown');

    document.getElementById('litRecentLabel').textContent = '최근 검색어';
    document.getElementById('historyEmpty').textContent   = '검색 기록이 없습니다.';

    searchInput.addEventListener('focus', function() { loadHistory(); });
    searchInput.addEventListener('input', function() {
        clearTimeout(_suggestTimer);
        var q = this.value.trim();
        if (q.length >= 2) {
            _suggestTimer = setTimeout(function() { loadSuggest(q); }, 300);
        } else {
            loadHistory();
        }
    });
    document.addEventListener('click', function(e) {
        if (!document.getElementById('searchBox').contains(e.target))
            dropdown.classList.add('hidden');
    });

    function loadHistory() {
        fetch('/SearchResults?handler=History')
            .then(function(r) { return r.json(); })
            .then(function(list) {
                var ul = document.getElementById('historyList');
                var em = document.getElementById('historyEmpty');
                if (!list || list.length === 0) {
                    ul.innerHTML = ''; em.classList.remove('hidden');
                } else {
                    em.classList.add('hidden');
                    ul.innerHTML = list.map(function(h) {
                        return '<li class="flex items-center justify-between px-4 py-2 hover:bg-gray-50 dark:hover:bg-slate-700 cursor-pointer group">'
                            + '<span class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300" onclick="document.getElementById(\'topSearchInput\').value=\'' + escapeHtml(h.query) + '\';doSearch();">'
                            + '<i data-lucide="clock" class="w-3 h-3 text-gray-400"></i>' + escapeHtml(h.query) + '</span>'
                            + '<button type="button" onclick="deleteHistory(' + h.id + ',this)" class="text-gray-300 hover:text-red-400 text-lg leading-none opacity-0 group-hover:opacity-100">×</button>'
                            + '</li>';
                    }).join('');
                    lucide.createIcons();
                }
                dropdown.classList.remove('hidden');
            });
    }

    function loadSuggest(q) {
        fetch('/SearchResults?handler=Suggest&q=' + encodeURIComponent(q))
            .then(function(r) { return r.json(); })
            .then(function(list) {
                var ul = document.getElementById('historyList');
                var em = document.getElementById('historyEmpty');
                if (!list || list.length === 0) {
                    ul.innerHTML = ''; em.classList.remove('hidden');
                } else {
                    em.classList.add('hidden');
                    ul.innerHTML = list.map(function(s) {
                        return '<li class="px-4 py-2 hover:bg-gray-50 dark:hover:bg-slate-700 cursor-pointer text-sm text-gray-700 dark:text-slate-300 flex items-center gap-2" onclick="document.getElementById(\'topSearchInput\').value=\'' + escapeHtml(s) + '\';doSearch();">'
                            + '<i data-lucide="search" class="w-3 h-3 text-gray-400"></i>' + escapeHtml(s) + '</li>';
                    }).join('');
                    lucide.createIcons();
                }
                dropdown.classList.remove('hidden');
            });
    }

    function deleteHistory(id, btn) {
        fetch('/SearchResults?handler=DeleteHistory&id=' + id)
            .then(function() {
                var li = btn.closest ? btn.closest('li') : btn.parentNode;
                if (li) li.remove();
            });
    }

    // ── 엔진 탭 클릭 ──
    document.querySelectorAll('.engine-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.engine-tab').forEach(function(t) {
                t.classList.remove('border-b-2', 'border-blue-500', 'text-blue-600', 'dark:text-blue-400', '-mb-px');
                t.classList.add('text-gray-500', 'dark:text-slate-400');
            });
            this.classList.add('border-b-2', 'border-blue-500', 'text-blue-600', 'dark:text-blue-400', '-mb-px');
            this.classList.remove('text-gray-500', 'dark:text-slate-400');

            activeTab = this.getAttribute('data-tab');
            var items = getItemsByTab(activeTab);
            switchTab(items);
        });
    });

    function getItemsByTab(tab) {
        if (tab === 'all')    return getAllItems();
        if (tab === 'google') return _google;
        if (tab === 'naver')  return _naver;
        if (tab === 'brave')  return _brave;
        return _daum;
    }

    function getAllItems() {
        // _ranked(AI 재정렬 상위 10개) + 나머지 전체 RRF 결과 합산
        var base = (_results && _results.length > 0)
            ? _results
            : weightedMix(_google, _naver, _daum, _brave, [_scores.google, _scores.naver, _scores.daum, _scores.brave||0]);
        if (!_ranked || _ranked.length === 0) return base;
        var rankedUrls = {};
        _ranked.forEach(function(r) { if (r && r.url) rankedUrls[r.url.toLowerCase()] = true; });
        var remainder = base.filter(function(r) { return r && r.url && !rankedUrls[r.url.toLowerCase()]; });
        return _ranked.concat(remainder);
    }

    // RRF 클라이언트 폴백 (4엔진)
    function weightedMix(g, n, d, b, s) {
        var k = 60;
        var scoreMap = {}, itemMap = {};
        var engines = [g, n, d, b||[]];
        for (var e = 0; e < engines.length; e++) {
            var w = (s && s[e]) ? s[e] : 1;
            for (var r = 0; r < engines[e].length; r++) {
                var item = engines[e][r];
                var url = item && item.url;
                if (!url) continue;
                if (!scoreMap[url]) { scoreMap[url] = 0; itemMap[url] = item; }
                scoreMap[url] += w / (k + r + 1);
            }
        }
        return Object.keys(scoreMap)
            .sort(function(a, b) { return scoreMap[b] - scoreMap[a]; })
            .map(function(u) { return itemMap[u]; });
    }

    function switchTab(items) {
        activeItems = items || [];
        currentPage = 1;
        renderResultsPage();
    }

    // ── 결과 렌더링 ──
    function renderResultsPage() {
        var container    = document.getElementById('resultsContainer');
        var noResultsDiv = document.getElementById('noResults');

        if (!activeItems || activeItems.length === 0) {
            container.innerHTML = '';
            document.getElementById('paginationContainer').innerHTML = '';
            if (_query) noResultsDiv.style.display = 'flex';
            document.getElementById('litResultsLabel').textContent = '';
            return;
        }
        noResultsDiv.style.display = 'none';

        // currentPage는 1부터 시작하는 절대 페이지 번호
        var start     = (currentPage - 1) * PAGE_SIZE;
        var pageItems = activeItems.slice(start, start + PAGE_SIZE);

        // 결과 수 표시
        document.getElementById('litResultsLabel').textContent =
            '검색 결과 약 ' + activeItems.length + '개';

        var html = '';
        pageItems.forEach(function(item) {
            var src      = item.source || item.src || '';
            var srcLabel = src === 'google' ? 'Google' : src === 'naver' ? '네이버' : src === 'brave' ? 'Brave' : '다음';
            var srcCss   = src === 'google'
                ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300'
                : src === 'naver'
                ? 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300'
                : src === 'brave'
                ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300'
                : 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300';

            var imgHtml = '';
            var imgUrl  = item.imageUrl || item.img || '';
            if (imgUrl) {
                imgHtml = '<img src="' + escapeHtml(imgUrl) + '" alt=""'
                    + ' class="w-28 h-20 object-cover rounded-lg flex-shrink-0 ml-4 bg-gray-100 dark:bg-slate-700"'
                    + ' onerror="this.style.display=\'none\'">';
            }

            html +=
                '<div class="group mb-8 flex items-start" data-url="' + escapeHtml(item.url || '') + '">'
                + '<div class="flex-1 min-w-0">'
                + '<div class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400 mb-1">'
                + '<span class="text-xs px-2 py-0.5 rounded-full font-medium ' + srcCss + '">' + srcLabel + '</span>'
                + '<i data-lucide="globe" class="w-4 h-4 flex-shrink-0"></i>'
                + '<span class="truncate max-w-md text-xs">' + escapeHtml(item.url || '') + '</span>'
                + '</div>'
                + '<a href="' + escapeHtml(item.url || '') + '" target="_blank"'
                + '   class="text-xl text-blue-600 dark:text-blue-400 hover:underline cursor-pointer font-medium">'
                + escapeHtml(item.title || '')
                + '</a>'
                + '<p class="mt-1 text-sm text-gray-700 dark:text-slate-300 line-clamp-2">'
                + escapeHtml(item.description || item.desc || '') + '</p>'
                + '</div>'
                + imgHtml
                + '</div>';
        });
        container.innerHTML = html;
        if (typeof lucide !== 'undefined') lucide.createIcons();

        renderPagination(activeItems.length);
    }

    // ── 페이지네이션 (prev/next + 스마트 번호) ──
    function renderPagination(totalCount) {
        var pgContainer  = document.getElementById('paginationContainer');
        var batchPages   = Math.ceil(totalCount / PAGE_SIZE);
        if (batchPages === 0) { pgContainer.innerHTML = ''; return; }

        var btnBase = 'inline-flex items-center justify-center w-9 h-9 rounded-lg text-sm font-medium transition-colors ';
        var btnNorm = btnBase + 'text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-700';
        var btnAct  = btnBase + 'bg-blue-600 text-white cursor-default';
        var btnDis  = btnBase + 'text-gray-300 dark:text-slate-600 cursor-not-allowed';
        var prevSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>';
        var nextSvg = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';

        var html = '<div class="flex items-center justify-center gap-1 py-4 border-t border-gray-200 dark:border-slate-700">';

        // 이전 버튼
        if (currentPage > 1)
            html += '<button type="button" class="' + btnNorm + '" onclick="goToPage(' + (currentPage - 1) + ')">' + prevSvg + '</button>';
        else
            html += '<button type="button" class="' + btnDis + '" disabled>' + prevSvg + '</button>';

        // 페이지 번호 (현재 ±2, 앞뒤 ... 처리)
        var startPage = Math.max(1, currentPage - 2);
        var endPage   = Math.min(batchPages, currentPage + 2);

        if (startPage > 1) {
            html += '<button type="button" class="' + btnNorm + '" onclick="goToPage(1)">1</button>';
            if (startPage > 2) html += '<span class="px-1 text-gray-400">…</span>';
        }
        for (var p = startPage; p <= endPage; p++) {
            if (p === currentPage)
                html += '<button type="button" class="' + btnAct + '">' + p + '</button>';
            else
                html += '<button type="button" class="' + btnNorm + '" onclick="goToPage(' + p + ')">' + p + '</button>';
        }
        if (endPage < batchPages) {
            if (endPage < batchPages - 1) html += '<span class="px-1 text-gray-400">…</span>';
            html += '<button type="button" class="' + btnNorm + '" onclick="goToPage(' + batchPages + ')">' + batchPages + '</button>';
        }

        // 다음 버튼 (마지막 배치 마지막 페이지가 아니면 항상 활성)
        html += '<button type="button" class="' + btnNorm + '" onclick="goToPage(' + (currentPage + 1) + ')">' + nextSvg + '</button>';

        html += '</div>';
        pgContainer.innerHTML = html;
    }

    function goToPage(page) {
        if (page < 1) return;
        var totalPages = Math.ceil(activeItems.length / PAGE_SIZE);
        // 마지막 페이지 이후 → 배치 추가 로드 (최대 3번)
        if (page > totalPages && batchCount < 3) {
            loadNextBatch(page);
            return;
        }
        if (page > totalPages) return; // 3번 배치 후에도 없으면 중단
        currentPage = page;
        renderResultsPage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 다음 배치 AJAX 로드 — batchCount 증가, batch=2/3/4 순서로 서버 호출
    function loadNextBatch(targetPage) {
        if (isLoadingBatch) return;
        isLoadingBatch = true;
        batchCount++;  // 이번 배치 번호 (1→batch=2, 2→batch=3, 3→batch=4)

        document.getElementById('resultsContainer').innerHTML =
            '<div class="flex flex-col items-center justify-center py-20">'
            + '<div class="w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mb-4"></div>'
            + '<p class="text-gray-400 dark:text-slate-500 text-sm">다음 검색 결과를 가져오는 중...</p>'
            + '</div>';
        document.getElementById('paginationContainer').innerHTML = '';

        var batchNum = batchCount + 1;  // batchCount=1→batch=2, 2→3, 3→4
        fetch('/SearchResults?handler=Batch&q=' + encodeURIComponent(_query) + '&batch=' + batchNum)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                // 배치 결과를 기존 배열에 합산 (URL 중복 제거)
                var seen = {};
                _google.forEach(function(r) { if (r && r.url) seen[r.url.toLowerCase()] = true; });
                _naver.forEach(function(r)  { if (r && r.url) seen[r.url.toLowerCase()] = true; });
                _daum.forEach(function(r)   { if (r && r.url) seen[r.url.toLowerCase()] = true; });
                _brave.forEach(function(r)  { if (r && r.url) seen[r.url.toLowerCase()] = true; });

                if (data.google) data.google.forEach(function(r) {
                    if (r && r.url && !seen[r.url.toLowerCase()]) { _google.push(r); seen[r.url.toLowerCase()] = true; }
                });
                if (data.naver) data.naver.forEach(function(r) {
                    if (r && r.url && !seen[r.url.toLowerCase()]) { _naver.push(r);  seen[r.url.toLowerCase()] = true; }
                });
                if (data.daum) data.daum.forEach(function(r) {
                    if (r && r.url && !seen[r.url.toLowerCase()]) { _daum.push(r);   seen[r.url.toLowerCase()] = true; }
                });
                if (data.brave) data.brave.forEach(function(r) {
                    if (r && r.url && !seen[r.url.toLowerCase()]) { _brave.push(r);  seen[r.url.toLowerCase()] = true; }
                });

                // _results에도 새 항목 추가 (all 탭용)
                var newItems = (data.google || []).concat(data.naver || [], data.daum || [], data.brave || []);
                newItems.forEach(function(r) {
                    if (r && r.url) _results.push(r);
                });

                isLoadingBatch = false;

                var items = getItemsByTab(activeTab);
                activeItems = items || [];
                currentPage = targetPage <= Math.ceil(activeItems.length / PAGE_SIZE) ? targetPage : Math.ceil(activeItems.length / PAGE_SIZE);
                renderResultsPage();
            })
            .catch(function() {
                batchCount--;  // 실패 시 카운트 복구
                isLoadingBatch = false;
                renderResultsPage();
            });
    }

    // ── Extra 패널 렌더링 (원본과 동일) ──
    function renderExtraPanel() {
        var panel = document.getElementById('extraPanel');
        try {
            var data = JSON.parse(_extra);
            if (!data || !data.type) { panel.classList.add('hidden'); return; }
            var inner = '';
            if      (data.type === 'places')   inner = renderPlaces(data);
            else if (data.type === 'shopping') inner = renderShopping(data);
            else if (data.type === 'news')     inner = renderNews(data);
            else if (data.type === 'wiki')     inner = renderWiki(data);
            else if (data.type === 'exchange') inner = renderExchange(data);
            else if (data.type === 'youtube')  inner = renderYoutube(data);
            else if (data.type === 'weather')  inner = renderWeather(data);
            else if (data.type === 'blog')     inner = renderBlog(data);
            if (!inner) { panel.classList.add('hidden'); return; }
            panel.innerHTML = '<div class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl p-5">' + inner + '</div>';
            panel.classList.remove('hidden');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        } catch(e) { panel.classList.add('hidden'); }
    }

    // 패널 공통 헤더
    function panelHeader(icon, title, source) {
        return '<div class="flex items-center justify-between mb-4">'
            + '<div class="flex items-center gap-2">'
            + '<i data-lucide="' + icon + '" class="w-4 h-4 text-blue-500"></i>'
            + '<span class="font-semibold text-sm text-gray-800 dark:text-white">' + escapeHtml(title) + '</span>'
            + '</div>'
            + '<span class="text-xs text-gray-400 dark:text-slate-500">제공: ' + escapeHtml(source) + '</span>'
            + '</div>';
    }

    // 카카오 로컬 장소 (가로 스크롤 카드)
    function renderPlaces(data) {
        var items = data.items || [];
        if (!items.length) return '';
        var html = panelHeader('map-pin', '장소 정보', '카카오맵');
        html += '<div class="flex gap-3 overflow-x-auto pb-2">';
        items.forEach(function(p) {
            var cat = p.category ? p.category.split('>').pop().trim() : '';
            html += '<a href="' + escapeHtml(p.url||'#') + '" target="_blank" rel="noopener"'
                + ' class="flex-shrink-0 w-44 bg-gray-50 dark:bg-slate-700/50 rounded-xl p-3 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors" style="text-decoration:none">'
                + '<div class="font-semibold text-sm text-gray-900 dark:text-white truncate mb-1">' + escapeHtml(p.name) + '</div>'
                + (cat ? '<div class="text-xs text-blue-500 dark:text-blue-400 mb-1">' + escapeHtml(cat) + '</div>' : '')
                + '<div class="text-xs text-gray-500 dark:text-slate-400 mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">' + escapeHtml(p.address||'') + '</div>'
                + (p.phone ? '<div class="text-xs text-gray-400 dark:text-slate-500">' + escapeHtml(p.phone) + '</div>' : '')
                + '</a>';
        });
        html += '<a href="https://map.kakao.com/?q=' + encodeURIComponent(_query) + '" target="_blank" rel="noopener"'
            + ' class="flex-shrink-0 w-44 bg-blue-50 dark:bg-blue-900/20 rounded-xl p-3 flex flex-col items-center justify-center gap-2 hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-colors" style="text-decoration:none">'
            + '<i data-lucide="map" class="w-6 h-6 text-blue-500"></i>'
            + '<span class="text-xs text-blue-600 dark:text-blue-400 font-medium text-center">카카오맵에서<br>더 보기</span>'
            + '</a>';
        html += '</div>';
        return html;
    }

    // 네이버 쇼핑 (가로 스크롤 카드)
    function renderShopping(data) {
        var items = data.items || [];
        if (!items.length) return '';
        var html = panelHeader('shopping-bag', '쇼핑', '네이버 쇼핑');
        html += '<div class="flex gap-3 overflow-x-auto pb-2">';
        items.forEach(function(s) {
            var price = s.price ? parseInt(s.price, 10).toLocaleString() + '원' : '';
            html += '<a href="' + escapeHtml(s.link||'#') + '" target="_blank" rel="noopener"'
                + ' class="flex-shrink-0 w-36 bg-gray-50 dark:bg-slate-700/50 rounded-xl overflow-hidden hover:shadow-md transition-shadow" style="text-decoration:none">'
                + (s.image ? '<img src="' + escapeHtml(s.image) + '" alt="" class="w-full h-28 object-cover" onerror="this.style.display=\'none\'">' : '<div class="w-full h-28 bg-gray-200 dark:bg-slate-600 flex items-center justify-center"><i data-lucide="image" class="w-8 h-8 text-gray-400"></i></div>')
                + '<div class="p-2">'
                + '<div class="text-xs text-gray-800 dark:text-slate-200 font-medium mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">' + escapeHtml(s.title) + '</div>'
                + '<div class="text-xs text-gray-500 dark:text-slate-400 truncate mb-0.5">' + escapeHtml(s.mall||'') + '</div>'
                + (price ? '<div class="text-xs font-bold text-blue-600 dark:text-blue-400">' + price + '</div>' : '')
                + '</div></a>';
        });
        html += '</div>';
        return html;
    }

    // 네이버 뉴스
    function renderNews(data) {
        var items = data.items || [];
        if (!items.length) return '';
        var html = panelHeader('newspaper', '뉴스', '네이버 뉴스');
        html += '<div class="space-y-1">';
        items.forEach(function(n, i) {
            var dateStr = formatNewsDate(n.pub);
            html += '<a href="' + escapeHtml(n.link||'#') + '" target="_blank" rel="noopener"'
                + ' class="flex gap-3 items-start rounded-lg p-2 -mx-2 hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors" style="text-decoration:none">'
                + '<span class="text-xs font-bold text-blue-500 dark:text-blue-400 w-4 flex-shrink-0 mt-0.5">' + (i+1) + '</span>'
                + '<div class="flex-1 min-w-0">'
                + '<div class="text-sm font-medium text-gray-800 dark:text-slate-200 truncate">' + escapeHtml(n.title) + '</div>'
                + (n.desc ? '<div class="text-xs text-gray-500 dark:text-slate-400 truncate mt-0.5">' + escapeHtml(n.desc) + '</div>' : '')
                + '</div>'
                + (dateStr ? '<span class="text-xs text-gray-400 dark:text-slate-500 flex-shrink-0">' + escapeHtml(dateStr) + '</span>' : '')
                + '</a>';
        });
        html += '</div>';
        return html;
    }

    // 네이버 블로그
    function renderBlog(data) {
        var items = data.items || [];
        if (!items.length) return '';
        var html = panelHeader('pen-line', '블로그', '네이버 블로그');
        html += '<div class="space-y-1">';
        items.forEach(function(b, i) {
            html += '<a href="' + escapeHtml(b.link||'#') + '" target="_blank" rel="noopener"'
                + ' class="flex gap-3 items-start rounded-lg p-2 -mx-2 hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors" style="text-decoration:none">'
                + '<span class="text-xs font-bold text-blue-500 dark:text-blue-400 w-4 flex-shrink-0 mt-0.5">' + (i+1) + '</span>'
                + '<div class="flex-1 min-w-0">'
                + '<div class="text-sm font-medium text-gray-800 dark:text-slate-200 truncate">' + escapeHtml(b.title||'') + '</div>'
                + (b.desc ? '<div class="text-xs text-gray-500 dark:text-slate-400 truncate mt-0.5">' + escapeHtml(b.desc) + '</div>' : '')
                + (b.blogger ? '<div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">' + escapeHtml(b.blogger) + '</div>' : '')
                + '</div></a>';
        });
        html += '</div>';
        return html;
    }

    // Wikipedia
    function renderWiki(data) {
        if (!data.extract) return '';
        var html = panelHeader('globe', '위키피디아', 'Wikipedia');
        html += '<div class="flex gap-4">';
        if (data.thumbnail) html += '<img src="' + escapeHtml(data.thumbnail) + '" alt="" class="w-20 h-20 object-cover rounded-lg flex-shrink-0" onerror="this.style.display=\'none\'">';
        html += '<div class="flex-1 min-w-0">'
            + '<div class="font-semibold text-gray-900 dark:text-white text-sm mb-1">' + escapeHtml(data.title||'') + '</div>'
            + '<p class="text-xs text-gray-600 dark:text-slate-400" style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden">' + escapeHtml(data.extract) + '</p>'
            + (data.url ? '<a href="' + escapeHtml(data.url) + '" target="_blank" rel="noopener" class="text-xs text-blue-500 hover:underline mt-1 inline-block">자세히 보기 →</a>' : '')
            + '</div></div>';
        return html;
    }

    // 환율
    function renderExchange(data) {
        if (!data.rates) return '';
        var labels = { USD:'달러', JPY:'엔화', EUR:'유로', CNY:'위안', GBP:'파운드' };
        var flags  = { USD:'🇺🇸', JPY:'🇯🇵', EUR:'🇪🇺', CNY:'🇨🇳', GBP:'🇬🇧' };
        var html = panelHeader('banknote', '실시간 환율', 'ExchangeRate-API');
        html += '<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">';
        ['USD','JPY','EUR','CNY','GBP'].forEach(function(code) {
            if (!data.rates[code]) return;
            var rate = parseFloat(data.rates[code]).toLocaleString('ko-KR', { minimumFractionDigits:2, maximumFractionDigits:2 });
            html += '<div class="bg-gray-50 dark:bg-slate-700/50 rounded-xl p-3">'
                + '<div class="flex items-center gap-1.5 mb-1"><span>' + (flags[code]||'') + '</span>'
                + '<span class="text-xs font-bold text-gray-700 dark:text-slate-300">' + code + '</span>'
                + '<span class="text-xs text-gray-400 dark:text-slate-500">' + (labels[code]||'') + '</span></div>'
                + '<div class="text-xs text-gray-500 dark:text-slate-400">1 ' + code + ' =</div>'
                + '<div class="text-sm font-bold text-blue-600 dark:text-blue-400">' + rate + ' 원</div>'
                + '</div>';
        });
        html += '</div>';
        if (data.updated) {
            var upd = data.updated.replace(/\s+\d+:\d+:\d+.*$/, '');
            html += '<div class="mt-3 text-xs text-gray-400 dark:text-slate-500">업데이트: ' + escapeHtml(upd) + ' | USD 기준</div>';
        }
        return html;
    }

    // YouTube (가로 스크롤 카드)
    function renderYoutube(data) {
        var items = data.items || [];
        if (!items.length) return '';
        var html = panelHeader('play-circle', 'YouTube 영상', 'YouTube Data API');
        html += '<div class="flex gap-3 overflow-x-auto pb-2">';
        items.forEach(function(v) {
            html += '<a href="https://www.youtube.com/watch?v=' + encodeURIComponent(v.id) + '" target="_blank" rel="noopener"'
                + ' class="flex-shrink-0 w-52 bg-gray-50 dark:bg-slate-700/50 rounded-xl overflow-hidden hover:shadow-md transition-shadow" style="text-decoration:none">'
                + '<div class="relative">'
                + (v.thumb ? '<img src="' + escapeHtml(v.thumb) + '" alt="" class="w-full h-28 object-cover">' : '<div class="w-full h-28 bg-gray-200 dark:bg-slate-600"></div>')
                + '<div class="absolute inset-0 flex items-center justify-center">'
                + '<div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center bg-opacity-90">'
                + '<svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>'
                + '</div></div></div>'
                + '<div class="p-2">'
                + '<div class="text-xs text-gray-800 dark:text-slate-200 font-medium mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">' + escapeHtml(v.title) + '</div>'
                + '<div class="text-xs text-gray-500 dark:text-slate-400 truncate">' + escapeHtml(v.channel||'') + '</div>'
                + '</div></a>';
        });
        html += '</div>';
        return html;
    }

    // 날씨
    function renderWeather(data) {
        if (!data.temp) return '';
        var iconUrl = data.icon ? 'https://openweathermap.org/img/wn/' + data.icon + '@@2x.png' : '';
        var html = panelHeader('cloud-sun', '현재 날씨', 'OpenWeatherMap');
        html += '<div class="flex flex-wrap items-center gap-6">'
            + '<div class="flex items-center gap-2">'
            + (iconUrl ? '<img src="' + iconUrl + '" alt="" class="w-16 h-16 flex-shrink-0">' : '')
            + '<div>'
            + '<div class="text-3xl font-bold text-gray-900 dark:text-white">' + escapeHtml(data.temp) + '°C</div>'
            + '<div class="text-sm text-gray-600 dark:text-slate-300 capitalize">' + escapeHtml(data.desc||'') + '</div>'
            + '<div class="text-xs text-gray-400 dark:text-slate-500">' + escapeHtml(data.city||'') + (data.country ? ' (' + escapeHtml(data.country) + ')' : '') + '</div>'
            + '</div></div>'
            + '<div class="grid grid-cols-2 gap-x-8 gap-y-1.5 text-sm">'
            + '<span class="text-gray-500 dark:text-slate-400">체감온도</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.feels||'') + '°C</span>'
            + '<span class="text-gray-500 dark:text-slate-400">습도</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.humidity||'') + '%</span>'
            + '<span class="text-gray-500 dark:text-slate-400">바람</span><span class="font-medium text-gray-800 dark:text-slate-200">' + escapeHtml(data.wind||'') + ' m/s</span>'
            + '</div></div>';
        return html;
    }

    // 뉴스 날짜 포맷
    function formatNewsDate(pubStr) {
        if (!pubStr) return '';
        try {
            var d = new Date(pubStr);
            if (isNaN(d.getTime())) return '';
            return (d.getMonth() + 1) + '월 ' + d.getDate() + '일';
        } catch(e) { return ''; }
    }

    // ── 관련 검색어 렌더링 ──
    function renderRelated() {
        if (!_related || _related.length === 0) return;
        var panel = document.getElementById('relatedPanel');
        var list  = document.getElementById('relatedList');
        list.innerHTML = _related.map(function(r) {
            return '<a href="/SearchResults?q=' + encodeURIComponent(r) + '"'
                + ' class="flex items-center gap-2 py-1.5 text-sm text-gray-700 dark:text-slate-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">'
                + '<i data-lucide="search" class="w-3 h-3 text-gray-400 flex-shrink-0"></i>'
                + escapeHtml(r) + '</a>';
        }).join('');
        panel.classList.remove('hidden');
        lucide.createIcons();
    }

    // HTML 이스케이프
    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>
}
