    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide 아이콘 -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        // Tailwind 다크모드 설정
        tailwind.config = { darkMode: 'class' }
    </script>
    <style>
        /* ── 버튼 스프링 바운스 ── */
        button:not(:disabled),
        a.btn {
            transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
                        box-shadow 0.18s ease,
                        background-color 0.15s ease,
                        color 0.15s ease,
                        border-color 0.15s ease;
        }
        button:hover:not(:disabled) {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 6px 16px rgba(0,0,0,0.10);
        }
        button:active:not(:disabled) {
            transform: translateY(1px) scale(0.97);
            box-shadow: none;
            transition-duration: 0.07s;
        }

        /* ── 카드(링크형) hover lift ── */
        a[href]:not(nav a):not(.no-lift) {
            transition: color 0.15s ease, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);
        }
        tr:has(a[href]):hover td {
            background-color: inherit;
        }

        /* ── 둥근 카드 컨테이너 hover shadow ── */
        .card-hover {
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }
        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.10);
        }

        /* ── input 포커스 글로우 ── */
        input:focus, textarea:focus {
            transition: box-shadow 0.2s ease, border-color 0.2s ease;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
        }

        /* ── 모달 페이드+스케일 인 ── */
        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.93) translateY(8px); }
            to   { opacity: 1; transform: scale(1)    translateY(0); }
        }
        #loginModal > div,
        #pwModal > div,
        #deleteModal > div,
        #withdrawModal > div,
        #ratingModal > div {
            animation: modalIn 0.22s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        #loginModal.hidden > div,
        #pwModal.hidden > div,
        #deleteModal.hidden > div,
        #withdrawModal.hidden > div,
        #ratingModal.hidden > div {
            animation: none;
        }

        /* ── 토스트 슬라이드 인 ── */
        @@keyframes toastIn {
            from { opacity: 0; transform: translateX(60px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        #toastBox {
            animation: toastIn 0.25s cubic-bezier(0.34,1.56,0.64,1) both;
        }

        /* ── 페이지 콘텐츠 페이드인 ── */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        body > *:not(nav) {
            animation: fadeUp 0.25s ease both;
        }

        /* ── 네비 링크 밑줄 슬라이드 ── */
        nav a {
            position: relative;
        }
        nav a::after {
            content: '';
            position: absolute;
            left: 0; bottom: -2px;
            width: 0; height: 2px;
            background: #3b82f6;
            transition: width 0.2s ease;
            border-radius: 1px;
        }
        nav a:hover::after { width: 100%; }
    </style>
</head>
<body class="bg-gray-50 dark:bg-slate-900 transition-colors duration-300">

